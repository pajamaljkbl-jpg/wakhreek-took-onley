# === SUPABASE (base de données) ===
# Crée un projet gratuit sur https://supabase.com
# Va dans Project Settings > API pour trouver ces valeurs
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...   # clé "service_role" (jamais exposée au navigateur)

# === ADMIN ===
# Mot de passe/secret que TOI seul connais, utilisé pour valider les
# paiements (abonnements, frais d'entrée) depuis le tableau de bord admin.
# Choisis une chaîne longue et aléatoire.
ADMIN_SECRET=change-moi-en-un-secret-long-et-aleatoire

# URL de ton site
NEXT_PUBLIC_SITE_URL=https://wakhreek.com

# Compte Wave de Wakh Reek, affiché pour les frais de 10F et 6000F
ADMIN_WAVE_NUMBER=77 000 00 00
# URL publique de l'image du QR Wave administrateur (Supabase Storage)
ADMIN_WAVE_QR_URL=https://xxxxx.supabase.co/storage/v1/object/public/public/qrcodes/admin-wave.png

# === WEBRTC / TURN ===
# Identifiants du serveur TURN (par exemple Metered.ca).
# Plusieurs URLs peuvent être séparées par des virgules.
TURN_URLS=turn:relay.metered.ca:80,turn:relay.metered.ca:443,turns:relay.metered.ca:443
TURN_USERNAME=ton-username-turn
TURN_CREDENTIAL=ton-credential-turn
